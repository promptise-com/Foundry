# Copy this file to .env and fill in the values.
# promptise run loads .env and never overrides a variable that is already set.

# platform.openai.com → API keys
OPENAI_API_KEY=

# Optional: another model (promptise.toml sets openai:gpt-5-mini as the default).
# Also change [env] required in promptise.toml to that provider's key.
# SUPPORT_BOT_MODEL=anthropic:claude-sonnet-4-5

# Bearer token clients send to `promptise run --serve`
# (required when it listens on a non-loopback host).
# PROMPTISE_SERVE_TOKEN=
